# Copy this file to .env and fill in your values.
# Real environment variables (set by your host) take precedence over this file.

# Dify app API — Dify app > "API Access". Use https://api.dify.ai/v1 for Dify Cloud,
# or https://your-dify-host/v1 for a self-hosted Dify.
DIFY_API_BASE=https://api.dify.ai/v1
DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: name of a Dify input variable that receives the UI language
# ("English" or "Bahasa Malaysia"). Leave empty if your app has no such variable.
DIFY_LANGUAGE_INPUT=

# Text the Dify prompt outputs when a person needs to help (see README).
HANDOFF_MARKER=[[HANDOFF]]

# Shown on the "contact TMS" card.
TMS_SUPPORT_EMAIL=[Official TMS email]
TMS_SUPPORT_PHONE=[Official TMS phone]
TMS_OFFICE_HOURS=[Office hours]
TMS_WEBSITE_URL=https://maclubsystem.com

# true shows raw Dify error details in the chat. Keep false in production.
APP_DEBUG=false
